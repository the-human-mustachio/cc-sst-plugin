{
  "name": "sst",
  "version": "1.0.0",
  "description": "Build and deploy full-stack applications with SST on AWS using Lambda, S3, DynamoDB, EventBridge, ECS, and Step Functions",
  "author": {
    "name": "Matt Puccio"
  },
  "license": "MIT",
  "keywords": ["sst", "serverless", "lambda", "aws", "infrastructure", "full-stack", "iac", "pulumi"],
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "userConfig": {
    "defaultStage": {
      "type": "string",
      "description": "Default SST stage name (e.g., 'dev', 'production')",
      "required": false
    },
    "awsRegion": {
      "type": "string",
      "description": "Default AWS region (e.g., 'us-east-1')",
      "required": false
    },
    "devMode": {
      "type": "boolean",
      "description": "Whether to default to dev mode patterns (sst dev) over deploy",
      "required": false
    }
  }
}
